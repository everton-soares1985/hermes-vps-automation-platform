[Unit]
Description=Private automation dashboard
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/automation/dashboard
EnvironmentFile=%h/.config/hermes/runtime.env
ExecStart=/srv/automation/dashboard/.venv/bin/python -X utf8 dashboard.py --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/automation/dashboard

[Install]
WantedBy=default.target
